# Local development secrets. Copy to .env and fill in; .env is git-ignored.
# Nothing here is read by the site at build time: the build is static and takes
# no secrets. These are for publishing, for pinging search engines and for
# reading what Search Console measured.

# --- Cloudflare Pages -------------------------------------------------------
# Account id: Cloudflare dashboard, any domain's Overview page, right column,
# or `wrangler whoami` once the token below works.
CLOUDFLARE_ACCOUNT_ID=

# API token: dashboard, My Profile, API Tokens, Create Token, Custom token.
# Minimum scope to publish:
#   Account | Cloudflare Pages        | Edit
#   User    | User Details            | Read      (wrangler whoami)
# Add only if you want the apex attached from a script rather than by hand:
#   Zone    | DNS                     | Edit      (zone meshin.co)
# Scope the token to the one account, and to the one zone if DNS is included.
CLOUDFLARE_API_TOKEN=

# The Pages project that serves meshin.pages.dev, and later the apex (L16).
CLOUDFLARE_PAGES_PROJECT=meshin

# --- Search engines ---------------------------------------------------------
# Nothing to set. An IndexNow key is public by design: it proves ownership by
# being fetchable, so it is a committed file under site/public/ rather than a
# secret, and scripts/indexnow-ping.mjs reads it back out of the build. To
# rotate it, replace that file with a new name and a matching body.

# --- Search Console ---------------------------------------------------------
# Read only by `npm run audit:demand`, which asks Google what people searched
# for when meshin.co appeared, and writes audits/search-demand.md. Nothing else
# reads these two, and neither is a deploy credential.
#
# Service-account key: Google Cloud console, IAM & Admin, Service Accounts,
# create one in a project that has the Search Console API enabled, then Keys,
# Add key, Create new key, JSON. Paste the whole downloaded file here on ONE
# line, with no quotes around it (single quotes also work; double quotes do
# not). It holds a private_key: treat it as a password, never commit it, and
# never paste it into a chat or an issue.
GSC_SERVICE_ACCOUNT_JSON=

# Permission: Search Console, Settings, Users and permissions, Add user, the
# client_email from that JSON, and choose Restricted. Restricted is enough
# because the script only reads: it asks for the read-only scope
# (webmasters.readonly) and runs the Performance query, and Google describes a
# Restricted user as one with view rights on most data. Full adds nothing the
# script uses and Owner is never needed, so give the account no more than it
# reads with.
#
# The property exactly as Search Console lists it: sc-domain:meshin.co for a
# Domain property, or the full address with its trailing slash for a URL-prefix
# property.
GSC_PROPERTY=sc-domain:meshin.co

# --- The unattended writer --------------------------------------------------
# Read only by `npm run write:entry`, which writes one blog post and, when the
# demand report names a concept the glossary does not define, one glossary term
# from committed claims. In the daily workflow these are repository variables
# and secrets; here they serve a local run. Nothing has a default in code: a
# missing or invalid value fails the run, names the variable and writes nothing.
#
# Which vendor writes. One implementation ships, openai. A later vendor is a new
# adapter file and one registry line, then a different value here.
WRITING_PROVIDER=openai

# The model id, GPT-6.1 Terra, which OpenAI's catalogue describes as its model
# for clear, natural writing. The string is the "Model ID" line of
# https://developers.openai.com/api/docs/models/gpt-6.1-terra, copied from that
# page and not derived from the display name. It is checked against
# GET https://api.openai.com/v1/models on the first call of a run: an id the
# list does not carry fails the run and names this variable and the value, and
# an id with an announced shutdown_date proceeds and is named in the morning
# digest, so change it before the morning it stops working.
OPENAI_WRITING_MODEL=gpt-6.1-terra

# What a token costs, in US dollars per million tokens, read from the model's
# page at https://developers.openai.com/api/docs/models/gpt-6.1-terra (input
# $1, output $5, prompts of at most 272K tokens). Reasoning tokens are billed
# as output tokens, so the output rate covers them. The ledger's spend fields
# are the response's token counts times these two numbers, so change them the
# day the vendor changes its prices.
OPENAI_WRITING_INPUT_USD_PER_MILLION=1
OPENAI_WRITING_OUTPUT_USD_PER_MILLION=5

# The key. It has a name of its own on purpose: a shell that already holds
# OPENAI_API_KEY for the geo probe must never spend on the writer. Create it in
# the vendor's console with a monthly spend limit at or below the $25 ceiling
# the loop enforces, paste it here with no quotes, and never commit it, print it
# or paste it into a chat or an issue. A run without it fails naming it and
# writes nothing.
AUTOWRITER_OPENAI_API_KEY=

# --- What a run chooses to write ---------------------------------------------
# Read only by `npm run pick:topic`, which decides what the writer is asked to
# write. The writer itself never reads them.
#
# Whether a run also writes the glossary terms that measured demand names and
# the glossary lacks, on top of the blog post every run writes: on or off. A
# site with no glossary sets off.
WRITING_TERM_ARM=on

# The most terms one run may add, a whole number from 1. The terms with the most
# measured impressions come first, and the digest names the rest.
WRITING_TERM_CAP=1
