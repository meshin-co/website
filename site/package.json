{
  "name": "site",
  "version": "1.0.0-beta.66",
  "description": "AstroWind: A free template using Astro 7 and Tailwind CSS v4. Astro starter theme.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/gen-headers.mjs dist && node scripts/generate-static-sidecars.mjs dist && node scripts/search-page-text.mjs dist && node scripts/gate.mjs dist budgets.json",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "node --test \"scripts/*.test.mjs\" \"src/utils/*.test.mjs\" \"src/data/*.test.mjs\"",
    "gate:visual": "playwright test",
    "gate:html": "html-validate \"dist/**/*.html\"",
    "gate:links": "linkinator dist --recurse --silent --skip \"plausible.io|linkedin.com|cal.com|github.com/meshin-co|^https://meshin.co\"",
    "gate:lh": "rm -rf .lighthouseci && lhci autorun --config=lighthouserc.cjs && node scripts/collect-reports.mjs mobile && rm -rf .lighthouseci && LHCI_FORM_FACTOR=desktop lhci autorun --config=lighthouserc.cjs && node scripts/collect-reports.mjs desktop",
    "gate:machine": "node scripts/machine.mjs dist",
    "gate:jsonld": "node scripts/jsonld-gate.mjs dist",
    "gate:skills": "node scripts/check-skills.mjs",
    "test:smoke": "node scripts/mutation-smoke.mjs",
    "gate:content": "node scripts/content-gate.mjs dist",
    "gate:orphans": "node scripts/orphan-gate.mjs dist",
    "gate:routes": "node scripts/routes-gate.mjs dist",
    "assets:og-default": "node scripts/generate-og-default.mjs",
    "assets:favicons": "node scripts/generate-favicons.mjs",
    "gate:lh:one": "rm -rf .lighthouseci && lhci autorun --config=lighthouserc.cjs && node scripts/collect-reports.mjs \"$LHCI_FORM_FACTOR\"",
    "assets:robots": "node scripts/gen-robots.mjs",
    "gate:plan": "node scripts/plan-gate.mjs",
    "assets:logo": "node scripts/generate-logo.mjs && node scripts/generate-favicons.mjs && prettier --write src/components/common/LogoMark.astro src/components/common/LogoSymbol.astro --log-level warn",
    "gate:editorial": "node scripts/editorial-gate.mjs . dist",
    "assets:registers": "node scripts/generate-registers.mjs",
    "gate:registers": "node scripts/generate-registers.mjs --check dist",
    "assets:gaps": "node scripts/generate-gaps.mjs dist",
    "assets:seal": "node scripts/editorial-gate.mjs . dist --seal",
    "audit:geo": "node scripts/generate-geo-baseline.mjs dist",
    "audit:polish": "node scripts/run-polish-sweep.mjs",
    "audit:prelaunch": "node scripts/run-pre-launch.mjs dist"
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.1",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.2.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "rehype-mermaid": "^3.0.0",
    "satori": "^0.33.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/tabler": "^1.2.38",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "astro-compress": "^2.4.3",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.9.0",
    "html-validate": "^11.14.0",
    "js-yaml": "^4.1.1",
    "linkinator": "^8.1.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "astro-compress": {
      "sharp": "^0.35.3",
      "svgo": "^4.0.2"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "deepmerge-ts": ">=8.0.2",
    "fast-uri": "^3.1.6"
  },
  "allowScripts": {
    "esbuild": true
  }
}
