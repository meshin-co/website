---
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { staticPageDate } from '~/utils/machine-text.mjs';
import { SITE } from 'astrowind:config';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const CONTACT_EMAIL = `hello@${SITE.name}`;
const UPDATED = staticPageDate('/security');

const metadata = {
  title: 'Security practices',
  description: `Security practices for ${SITE.name}: how this site is built and served, how client data is handled, and where to report a vulnerability.`,
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Security', path: '/security' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/security', UPDATED, metadata.title),
];

const posture = [
  {
    label: 'This site',
    items: [
      'Static files only. No server code, no database, no user accounts, no data-collection forms: the search box on this site never submits anywhere, and the Content-Security-Policy blocks form submission outright.',
      'Content Security Policy with no inline scripts. Every inline block is hashed at build time.',
      'No cookies, no consent banner, no cross-site tracking. Analytics are aggregate and cookieless.',
    ],
  },
  {
    label: 'My machine and accounts',
    items: [
      'Full-disk encryption on the machine I work from, with an automatic screen lock.',
      'Two-factor authentication on every work account, and passwords in a password manager rather than in a file or a browser.',
      'Nothing client-owned is used to train or improve a model.',
    ],
  },
  {
    label: 'Your systems and your data',
    items: [
      'I ask for a named account in your own systems, scoped to the work, so you hold the off-switch and revoke it at handover.',
      'The work happens inside your systems. I keep no copy of your documents, exports, tickets or logs.',
      'My own working notes are deleted at handover, and the handover lists every credential I held so revoking them is a checklist rather than a memory.',
    ],
  },
  {
    label: 'If something goes wrong',
    items: [
      'If I find that your material has been exposed, I tell you within 24 hours of finding out.',
      'You get what I know at that point, not a polished version of it a week later.',
      'Anything further, including who else must be notified, is set in your contract rather than on this page.',
    ],
  },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Security"
    title="Security practices for client work"
    lead="My security practices, in four parts: this site, my own machine, your systems and your data, and what happens if something goes wrong."
  />

  <Section title="Posture">
    <dl class="grid gap-px bg-line sm:grid-cols-2">
      {
        posture.map((block) => (
          <div class="bg-page p-6">
            <dt class="eyebrow">{block.label}</dt>
            <dd class="mt-4 grid gap-3">
              {block.items.map((item) => (
                <div class="max-w-[44ch] text-muted">{item}</div>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section eyebrow="Disclosure" title="Reporting something" tone="surface">
    <p class="max-w-[68ch] text-lg leading-relaxed text-muted">
      Email <a class="text-link underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with what you found and how
      to reproduce it. I reply within two working days and I will tell you when it is fixed. No bounty, no legal threats,
      and credit on request.
    </p>
    <p class="mt-6">
      <a class="text-link font-mono text-sm" href="/.well-known/security.txt">/.well-known/security.txt</a>
    </p>
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Need this written for your own company?"
      body="Answering a customer security questionnaire honestly is most of what the two-week Assessment produces."
    />
  </Section>
</Layout>
