---
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { SITE } from 'astrowind:config';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const UPDATED = '2026-09-13';

const metadata = {
  title: 'Imprint',
  description: `Imprint for ${SITE.name}: who is responsible for this site, how to reach them by email, where they work from, and what it is hosted on.`,
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Imprint', path: '/imprint' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/imprint', UPDATED, metadata.title),
];

const rows = [
  { label: 'Responsible', value: `Dmitri Meshin, Fractional Chief AI Officer, trading as ${SITE.name}` },
  { label: 'Contact', value: `hello@${SITE.name}` },
  { label: 'Working from', value: 'Remote worldwide' },
  { label: 'Hosting', value: 'Cloudflare Pages, static files only' },
  { label: 'Analytics', value: 'Plausible, cookieless and aggregate' },
  { label: 'Responsible for content', value: 'Dmitri Meshin' },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Imprint"
    title="Imprint"
    lead="This is the imprint. One person, and the details to prove it."
  />

  <Section title="Details">
    <dl class="grid gap-px bg-line sm:grid-cols-2">
      {
        rows.map((row) => (
          <div class="bg-page p-6">
            <dt class="eyebrow">{row.label}</dt>
            <dd class="mt-3 max-w-[48ch] text-muted">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>
</Layout>
