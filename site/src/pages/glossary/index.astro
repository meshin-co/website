---
import { getCollection } from 'astro:content';

import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import {
  breadcrumbNode,
  collectionNode,
  orgNode,
  personNode,
  termNode,
  termSetNode,
  websiteNode,
} from '~/utils/jsonld.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const terms = (await getCollection('glossary', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

const metadata = {
  title: 'AI governance glossary',
  description: 'Plain definitions of the AI governance terms that come up in security reviews and board meetings.',
};

const nodes = [
  orgNode(site),
  personNode(site),
  websiteNode(site),
  collectionNode(site, { path: '/glossary', name: metadata.title, description: metadata.description }),
  termSetNode(
    site,
    terms.map((term) => ({ id: term.id }))
  ),
  ...terms.map((term) => termNode(site, { id: term.id, ...term.data })),
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Glossary', path: '/glossary' },
  ]),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Section
    bordered={false}
    headingLevel={1}
    index="01"
    eyebrow="Glossary"
    title="The words procurement uses."
    lead="Short definitions, each with the primary source behind it. No vendor glossaries, no marketing terms."
  />

  <Section title="Terms">
    {
      terms.length === 0 ? (
        <p class="max-w-[62ch] text-muted">Nothing published yet.</p>
      ) : (
        <dl class="grid gap-px bg-line sm:grid-cols-2">
          {terms.map((term) => (
            <div class="bg-page p-6">
              <dt class="font-heading text-lg font-semibold text-heading">
                <a class="text-link" href={`/glossary/${term.id}`}>
                  {term.data.term}
                </a>
              </dt>
              <dd class="mt-3 max-w-[62ch] text-muted">{term.data.shortDefinition}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </Section>
</Layout>
