---
import { getCollection } from 'astro:content';

import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { collectionNode, orgNode, personNode, termNode, termSetNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const terms = (await getCollection('glossary', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

const metadata = {
  title: 'AI governance glossary',
  description: 'Plain definitions of the AI governance terms that come up in security reviews and board meetings.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Glossary', path: '/glossary' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: '/glossary',
    name: metadata.title,
    description: metadata.description,
    items: terms.map((term) => ({ url: `/glossary/${term.id}` })),
  }),
  termSetNode(
    site,
    terms.map((term) => ({ id: term.id }))
  ),
  ...terms.map((term) => termNode(site, { id: term.id, ...term.data })),
];

const HUB_DEFINITIONS: Record<string, string> = {
  'agentic-workflow': 'These are AI agents that plan, call tools and decide what happens next.',
  'ai-governance': 'These are the decisions and controls that manage AI risk.',
  'ai-register': "This is a company's inventory of every AI system it uses.",
  'eu-ai-act': 'This EU regulation sorts AI systems into risk tiers.',
  evals: "These are repeatable tests that score an AI system's output.",
  'human-in-the-loop': 'A person reviews or stops the output before it lands.',
  'iso-iec-42001': 'This certifiable standard sets how a company governs its AI.',
  'llm-gateway': 'Every model call passes through one gateway, for control.',
  'nist-ai-rmf': 'This voluntary US framework helps manage AI risk.',
  'shadow-ai': "These are AI tools staff use for work without security's approval.",
};

const cards = terms.map((term) => {
  const [primarySource] = term.data.sources;
  return {
    term,
    definition: HUB_DEFINITIONS[term.id] ?? term.data.term,
    source: { url: primarySource.url, host: new URL(primarySource.url).hostname.replace(/^www\./, '') },
  };
});
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <MarkdownAlternate path="/glossary" slot="head" />
  <link rel="alternate" type="application/rss+xml" title="meshin.co — Glossary" href="/glossary/rss.xml" slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Glossary"
    title="AI governance glossary"
    lead="The AI governance glossary: the words procurement uses, defined short, each with the primary source behind it. No vendor glossaries, no marketing terms."
  />

  <Section title="Terms">
    {
      terms.length === 0 ? (
        <p class="max-w-[62ch] text-muted">Nothing published yet.</p>
      ) : (
        <dl class="grid gap-px bg-line sm:grid-cols-2">
          {cards.map((card) => (
            <div class="bg-page p-6">
              <dt class="font-heading text-lg font-semibold text-heading">
                <a class="text-link" href={`/glossary/${card.term.id}`}>
                  {card.term.data.term}
                </a>
              </dt>
              <dd class="mt-3 max-w-[62ch] text-muted">{card.definition}</dd>
              <dd class="mt-3 font-mono text-xs text-muted">
                Source:{' '}
                <a class="text-link" href={card.source.url} target="_blank" rel="noopener nofollow">
                  {card.source.host}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </Section>
</Layout>
