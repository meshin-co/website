---
import { getCollection } from 'astro:content';
import { METADATA } from 'astrowind:config';

import CardGrid from '~/components/site/CardGrid.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import FigureStrip from '~/components/site/FigureStrip.astro';
import ShiftPanel from '~/components/site/ShiftPanel.astro';
import Hero from '~/components/site/Hero.astro';
import ResourceCard from '~/components/site/ResourceCard.astro';
import Section from '~/components/site/Section.astro';
import ServiceCard from '~/components/site/ServiceCard.astro';
import SignalList from '~/components/site/SignalList.astro';
import StepList from '~/components/site/StepList.astro';
import { artifactIds, cta, drivers, figures, hero, heroOffers, nudge, shift, signals } from '~/data/home';
import JsonLd from '~/components/common/JsonLd.astro';
import Layout from '~/layouts/PageLayout.astro';
import { isPublished } from '~/utils/feeds.mjs';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { staticPageDate } from '~/utils/machine-text.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { externalRelAttrs } from '~/utils/pipeline.mjs';
import { resourceFormat } from '~/utils/resource-card.mjs';

const metadata = {
  description:
    'Fractional Chief AI Officer for 30–300 person companies: governance that passes enterprise procurement, and agentic systems shipped to production with evals.',
};

const site = import.meta.env.SITE.replace(/\/$/, '');
const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/', staticPageDate('/'), METADATA.title?.default),
];
const services = (await getCollection('service', isPublished)).sort((a, b) => a.data.order - b.data.order);
const resourcesById = new Map(
  (await getCollection('resource', ({ data }) => !data.draft)).map((entry) => [entry.id, entry])
);
const resources = artifactIds.map((id) => resourcesById.get(id)).filter((entry) => entry !== undefined);
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <Hero
    title={hero.title}
    titleAccent={hero.titleAccent}
    sub={hero.sub}
    proof={hero.proof}
    ctaLabel={hero.ctaLabel}
    ctaHref={hero.ctaHref}
    offers={heroOffers}
    secondary={{ label: 'Read the method', href: '/approach' }}
  />

  <Section eyebrow="Track record" tone="surface">
    <FigureStrip figures={figures} />
  </Section>

  <Section eyebrow="Fit" title="Do you need a Fractional CAIO?">
    <SignalList items={signals.items} verdict={signals.verdict} />
  </Section>

  <Section eyebrow="Outcome" title={shift.title} tone="surface">
    <ShiftPanel before={shift.before} after={shift.after} />
  </Section>

  <Section
    eyebrow="Offers"
    title="Services"
    lead="Three ways in. Each one ends with an artifact you can hand to a customer, a board or an auditor."
  >
    <CardGrid>
      {
        services.map((service) => (
          <ServiceCard
            name={service.data.name}
            feeShape={service.data.feeShape}
            duration={service.data.duration}
            outcome={service.data.tagline}
            deliverables={service.data.deliverables}
            href={`/services/${service.id}`}
          />
        ))
      }
    </CardGrid>

    <div class="mt-10 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4 border-t border-line pt-8">
      <p class="max-w-[64ch] text-muted">{nudge.text}</p>
      <a class="link-signature font-mono text-sm" href={nudge.href} target="_blank" {...externalRelAttrs(nudge.href)}
        >{nudge.label}</a
      >
    </div>
  </Section>

  <Section
    eyebrow="Method"
    title="How I work"
    tone="page"
    lead="Six things decide whether an AI initiative reaches production. I measure all six, in this order, and the sixth is the one a stalled pilot has usually skipped."
  >
    <StepList steps={drivers} />
  </Section>

  <Section
    eyebrow="Artifacts"
    title="Proof"
    tone="surface"
    lead="Every template I use in engagements is described on its own page, so you can read the method before you buy it."
  >
    <CardGrid>
      {
        resources.map((resource) => (
          <ResourceCard
            name={resource.data.name}
            summary={resource.data.description}
            format={resourceFormat(resource.data)}
            status={resource.data.status}
            href={`/resources/${resource.id}`}
          />
        ))
      }
    </CardGrid>
  </Section>

  <Section>
    <CtaBlock title={cta.title} body={cta.body} label={cta.label} href={cta.href} note={cta.note} />
  </Section>
</Layout>
