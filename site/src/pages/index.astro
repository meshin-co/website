---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Fractional Chief AI Officer — meshin.co',
  ignoreTitleTemplate: true,
};

const sections = ['Do you need a Fractional CAIO?', 'Services', 'How I work', 'Proof', 'Case study', 'Latest writing'];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
    <h1 class="font-heading text-[clamp(2.2rem,5vw,3.5rem)] leading-tight font-semibold text-heading">
      AI leadership you can name on the org chart.
    </h1>
    <p class="mt-6 max-w-[70ch] text-muted">
      Fractional Chief AI Officer for 30–300 person companies. I build the governance that gets you through enterprise
      procurement and ship agentic systems that actually reach production — with evals, observability and a number in
      the contract.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-6">
      <a class="btn-primary" href="https://cal.com/meshin" target="_blank" rel="noopener">Book a 30-min fit call</a>
    </div>
    <p class="mt-8 font-mono text-sm text-muted">
      15+ years shipping software · Open-source AI Governance Starter Kit · ISO/IEC 42001 Lead Implementer (in progress)
    </p>
  </section>

  {
    sections.map((title) => (
      <section class="mx-auto max-w-5xl border-t border-line px-4 py-12">
        <h2 class="font-heading text-2xl font-semibold text-heading">{title}</h2>
        <p class="mt-3 text-muted">TODO(copy) — built in Phase 2 from PRD §9.1 and Appendix A.</p>
      </section>
    ))
  }
</Layout>
