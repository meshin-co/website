---
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';

import CardGrid from '~/components/site/CardGrid.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import PostCard from '~/components/site/PostCard.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { isLive, isPublished } from '~/utils/feeds.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const cases = (await getCollection('case', isPublished)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const hasLiveEntry = cases.some(isLive);

const metadata = {
  title: 'Fractional Chief AI Officer case study',
  description:
    'I have not published a Fractional Chief AI Officer case study yet. Client case studies appear here only once a client agrees in writing.',
  ...(hasLiveEntry ? {} : { robots: { index: false, follow: true } }),
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Case studies', path: '/case-studies' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: '/case-studies',
    name: 'Case studies',
    description: metadata.description,
    items: cases.map((entry) => ({ url: `/case-studies/${entry.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  {
    hasLiveEntry && (
      <Fragment slot="head">
        <MarkdownAlternate path="/case-studies" />
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${SITE.name} — Case studies`}
          href="/case-studies/rss.xml"
        />
      </Fragment>
    )
  }

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Evidence"
    title="Fractional chief AI officer case study"
    lead="I have not published a fractional chief AI officer case study yet. Client case studies appear here only once a client agrees in writing."
  />

  <Section title="Engagements">
    {
      cases.length === 0 ? (
        <p class="max-w-[62ch] text-muted">Nothing published yet.</p>
      ) : (
        <CardGrid columns={2}>
          {cases.map((entry) => (
            <PostCard
              title={entry.data.title}
              href={`/case-studies/${entry.id}`}
              excerpt={entry.data.description}
              date={entry.data.publishDate.toISOString()}
              readingTime={entry.data.duration}
              category={entry.data.client.industry}
            />
          ))}
        </CardGrid>
      )
    }
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Start with a 30-minute fit call."
      body="The 90-Day Production Sprint starts with the two-week Assessment."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
    />
  </Section>
</Layout>
