---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';

import CaseMetrics from '~/components/site/CaseMetrics.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import Section from '~/components/site/Section.astro';
import ShiftPanel from '~/components/site/ShiftPanel.astro';
import Layout from '~/layouts/PageLayout.astro';
import { articleMetadata } from '~/utils/machine-links.mjs';
import {
  glossaryStub,
  imageObject,
  orgNode,
  personNode,
  postEntityLinks,
  postNode,
  webPageNode,
  websiteNode,
} from '~/utils/jsonld.mjs';
import { countWords } from '~/utils/content-rules.mjs';
import { lastmod } from '~/utils/lastmod.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

export const getStaticPaths: GetStaticPaths = async () => {
  const cases = await getCollection('case');
  return cases.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

interface Props {
  entry: CollectionEntry<'case'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const offer = await getEntry(data.offer);
const terms = (await getCollection('glossary', ({ data: term }) => !term.draft)).map((glossaryEntry) => ({
  id: glossaryEntry.id,
  term: glossaryEntry.data.term,
}));
const site = import.meta.env.SITE.replace(/\/$/, '');

const metadata = articleMetadata(site, {
  title: data.title,
  description: data.description,
  ogImage: data.ogImage,
  canonical: data.canonical,
  collection: 'case',
  id: entry.id,
  publishDate: data.publishDate,
  updatedDate: data.updatedDate,
});

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Case studies', path: '/case-studies' },
  { name: data.title, path: `/case-studies/${entry.id}` },
];

const postForLinks = {
  id: entry.id,
  ...data,
  category: 'operating-model',
  section: 'case-studies',
  sources: [],
  tags: data.stack,
  wordCount: countWords((entry.body ?? '').replace(/[#>*_`[\]()!-]/g, ' ')),
  body: entry.body,
};
const { about, mentions } = postEntityLinks(postForLinks, terms);
const citedTermIds = [...new Set([...about, ...mentions])];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  ...citedTermIds.map((id) =>
    glossaryStub(
      site,
      terms.find((term) => term.id === id)
    )
  ),
  postNode(site, postForLinks, { basePath: '/case-studies', ogCollection: 'case', about, mentions }),
  webPageNode(
    site,
    `/case-studies/${entry.id}`,
    lastmod({ publishDate: data.publishDate, updatedDate: data.updatedDate }),
    data.title,
    { image: imageObject(metadata.openGraph.images[0]) }
  ),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />
  <MarkdownAlternate path={`/case-studies/${entry.id}`} slot="head" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="meshin.co — Case studies"
    href="/case-studies/rss.xml"
    slot="head"
  />

  <article>
    <Section
      bordered={false}
      headingLevel={1}
      eyebrow={[data.client.industry, data.client.size, data.duration].filter(Boolean).join(' · ')}
      title={data.title}
      lead={data.description}
    >
      <p class="font-mono text-xs text-muted" data-gate-ignore>
        Published{' '}
        <time datetime={data.publishDate.toISOString().slice(0, 10)}>
          {data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {' · Updated '}
        <time datetime={data.updatedDate.toISOString().slice(0, 10)}>
          {data.updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </p>
    </Section>

    {
      data.outcome.metrics.length > 0 && (
        <Section eyebrow="Numbers" title="Before and after" tone="surface">
          <CaseMetrics
            metrics={data.outcome.metrics}
            note={data.anonymized ? 'Client name withheld at their request.' : 'Published with permission.'}
          />
        </Section>
      )
    }

    <Section eyebrow="Shape" title="Problem and approach">
      <ShiftPanel
        before={{ label: 'The problem', items: [data.problem] }}
        after={{ label: 'The approach', items: [data.approach] }}
      />
    </Section>

    <Section eyebrow="Stack" title="What it runs on">
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {data.stack.map((item) => <li class="font-mono text-sm text-muted">{item}</li>)}
      </ul>
    </Section>

    <Section eyebrow="Detail" title="In my words" tone="surface">
      <div class="prose-brief prose-brief-headings max-w-[68ch]">
        <Content />
      </div>
    </Section>
  </article>

  <Section title="Next step">
    {
      offer && (
        <CtaBlock
          title={`This came out of the ${offer.data.name}.`}
          body={offer.data.tagline}
          label="See the offer"
          href={`/services/${offer.id}`}
          note="Or email hello@meshin.co"
        />
      )
    }
  </Section>
</Layout>
