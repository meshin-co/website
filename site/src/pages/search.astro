---
import SearchBox from '~/components/site/SearchBox.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { pageExists } from '~/utils/page-exists.mjs';

const metadata = {
  title: 'Search',
  description: 'Search the writing, glossary, services and case studies on this site.',
  robots: { index: false, follow: true },
};

const fallbackPaths = ['/blog', '/glossary', '/resources', '/faq', '/case-studies'].filter((path) => pageExists(path));
const joiner = Object.fromEntries(
  fallbackPaths.map((path, index) => [
    path,
    index === 0 ? '' : index === fallbackPaths.length - 1 ? ' and the ' : ', the ',
  ])
);
---

<Layout metadata={metadata}>
  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Search"
    title="Find it here."
    lead="The index is built with the site and runs in your browser. Nothing you type is sent anywhere."
  />

  <Section title="Query">
    <SearchBox />
    <noscript>
      <p class="mt-6 max-w-[62ch] text-muted">
        Search needs JavaScript. Without it, the <Fragment>
          {
            '/blog' in joiner && (
              <Fragment>
                {joiner['/blog']}
                <a class="text-link underline" href="/blog">
                  writing index
                </a>
              </Fragment>
            )
          }
          {
            '/glossary' in joiner && (
              <Fragment>
                {joiner['/glossary']}
                <a class="text-link underline" href="/glossary">
                  glossary
                </a>
              </Fragment>
            )
          }
          {
            '/resources' in joiner && (
              <Fragment>
                {joiner['/resources']}
                <a class="text-link underline" href="/resources">
                  resource list
                </a>
              </Fragment>
            )
          }
          {
            '/faq' in joiner && (
              <Fragment>
                {joiner['/faq']}
                <a class="text-link underline" href="/faq">
                  questions and answers
                </a>
              </Fragment>
            )
          }
          {
            '/case-studies' in joiner && (
              <Fragment>
                {joiner['/case-studies']}
                <a class="text-link underline" href="/case-studies">
                  case studies
                </a>
              </Fragment>
            )
          }
        </Fragment> name everything on the site.
      </p>
    </noscript>
  </Section>
</Layout>
