---
import { getCollection } from 'astro:content';

import CtaBlock from '~/components/site/CtaBlock.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { breadcrumbNode, orgNode, personNode, speakingListNode } from '~/utils/jsonld.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const appearances = (await getCollection('speaking')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const metadata = {
  title: 'Speaking',
  description: 'Agentic systems, AI governance and who owns AI risk, when I am asked to speak.',
};

const nodes = [
  orgNode(site),
  personNode(site),
  speakingListNode(
    site,
    appearances.map((entry) => ({ ...entry.data }))
  ),
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Speaking', path: '/speaking' },
  ]),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Speaking"
    title="Speaking on AI governance"
    lead="Speaking on AI governance, when the invitation fits. I would rather talk about what broke in production than what is coming next year."
  />

  <Section title="Appearances">
    {
      appearances.length === 0 ? (
        <p class="max-w-[62ch] text-muted">Nothing scheduled.</p>
      ) : (
        <ol class="grid gap-px bg-line">
          {appearances.map((entry) => (
            <li class="grid gap-2 bg-page p-6 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <p class="font-mono text-sm text-muted">
                <time datetime={entry.data.date.toISOString().slice(0, 10)}>
                  {entry.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
                </time>
                <span class="mt-1 block">{entry.data.type}</span>
              </p>
              <div>
                <h3 class="font-heading text-lg font-semibold text-heading">
                  {entry.data.url ? (
                    <a class="text-link" href={entry.data.url} target="_blank" rel="noopener">
                      {entry.data.title}
                    </a>
                  ) : (
                    entry.data.title
                  )}
                </h3>
                <p class="mt-2 max-w-[62ch] text-muted">{entry.data.event}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </Section>

  <Section title="Invitations">
    <CtaBlock
      title="Happy to speak if the audience is the one buying."
      body="Founders, CTOs and boards. I ask for a link to this site and nothing else."
      label="Email hello@meshin.co"
      href="mailto:hello@meshin.co"
      note="Or book a call if it is easier"
    />
  </Section>
</Layout>
