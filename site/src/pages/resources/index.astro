---
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';

import CardGrid from '~/components/site/CardGrid.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import ResourceCard from '~/components/site/ResourceCard.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { resourceFormat } from '~/utils/resource-card.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const resources = (await getCollection('resource', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime()
);

const metadata = {
  title: 'AI governance templates and checklists',
  description:
    'AI governance templates, each described on its own page: what is inside, how to use it and where its content comes from.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Resources', path: '/resources' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: '/resources',
    name: 'Resources',
    description: metadata.description,
    items: resources.map((resource) => ({ url: `/resources/${resource.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <MarkdownAlternate path="/resources" slot="head" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${SITE.name} — Resources`}
    href="/resources/rss.xml"
    slot="head"
  />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Artifacts"
    title="AI governance templates"
    lead="AI governance templates, each described on its own page. Copy one into your own wiki: no tool, no subscription, no email required. Each page says where its content comes from."
  />

  <Section title="Available now">
    <CardGrid columns={resources.length > 1 ? 2 : 1}>
      {
        resources.map((resource) => (
          <ResourceCard
            name={resource.data.name}
            summary={resource.data.description}
            format={resourceFormat(resource.data)}
            status={resource.data.status}
            href={`/resources/${resource.id}`}
          />
        ))
      }
    </CardGrid>
  </Section>

  <Section title="Want help applying them">
    <CtaBlock
      title="The templates are the easy part."
      body="Filling them in against systems you already run is where it gets specific. That is what the two-week Assessment is for."
    />
  </Section>
</Layout>
