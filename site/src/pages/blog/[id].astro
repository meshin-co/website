---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import { SITE } from 'astrowind:config';

import AnswerBlock from '~/components/site/AnswerBlock.astro';
import AuthorBox from '~/components/site/AuthorBox.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import FaqList from '~/components/site/FaqList.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import KeyTakeaways from '~/components/site/KeyTakeaways.astro';
import PostCard from '~/components/site/PostCard.astro';
import ResourceCard from '~/components/site/ResourceCard.astro';
import Section from '~/components/site/Section.astro';
import SourceList from '~/components/site/SourceList.astro';
import TableOfContents from '~/components/site/TableOfContents.astro';
import Layout from '~/layouts/PageLayout.astro';
import { categoryPillars } from '~/data/categories.mjs';
import { tagBySlug } from '~/data/tags.mjs';
import { articleMetadata } from '~/utils/machine-links.mjs';
import {
  faqNode,
  glossaryStub,
  imageObject,
  orgNode,
  personNode,
  postEntityLinks,
  postNode,
  webPageNode,
  websiteNode,
} from '~/utils/jsonld.mjs';
import { neighbourPosts, relatedPosts } from '~/utils/post-neighbors.mjs';
import { readingTime } from '~/utils/reading-time.mjs';
import { countWords } from '~/utils/content-rules.mjs';
import { lastmod } from '~/utils/lastmod.mjs';
import { resourceCardProps } from '~/utils/resource-card.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { isPublished } from '~/utils/feeds.mjs';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('post', isPublished);
  const byCategory = new Map<string, CollectionEntry<'post'>[]>();
  for (const post of posts) {
    const list = byCategory.get(post.data.category) ?? [];
    list.push(post);
    byCategory.set(post.data.category, list);
  }
  return posts.map((post) => {
    const categoryPosts = byCategory.get(post.data.category) ?? [];
    const { previous, next } = neighbourPosts(categoryPosts, post.id);
    return {
      params: { id: post.id },
      props: { post, previous, next, related: relatedPosts(categoryPosts, post.id) },
    };
  });
};

interface Props {
  post: CollectionEntry<'post'>;
  previous: CollectionEntry<'post'> | null;
  next: CollectionEntry<'post'> | null;
  related: CollectionEntry<'post'>[];
}

const { post, previous, next, related } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const author = await getEntry(data.author);
const relatedResources = data.relatedResources.length > 0 ? await getEntries(data.relatedResources) : [];
const terms = (await getCollection('glossary', ({ data: term }) => !term.draft)).map((entry) => ({
  id: entry.id,
  term: entry.data.term,
}));
const site = import.meta.env.SITE.replace(/\/$/, '');
const published = data.publishDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const categoryTitle = categoryPillars[data.category]?.title ?? data.category;

const metadata = articleMetadata(site, {
  title: data.title,
  description: data.description,
  ogImage: data.ogImage,
  canonical: data.canonical,
  collection: 'post',
  id: post.id,
  publishDate: data.publishDate,
  updatedDate: data.updatedDate,
  noindex: data.noindex,
  section: categoryTitle,
  tags: data.tags.map((slug) => tagBySlug[slug]?.name ?? slug),
});

const postForLinks = {
  id: post.id,
  ...data,
  wordCount: countWords((post.body ?? '').replace(/[#>*_`[\]()!-]/g, ' ')),
  body: post.body,
};
const { about, mentions } = postEntityLinks(postForLinks, terms);
const citedTermIds = [...new Set([...about, ...mentions])];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  ...citedTermIds.map((id) =>
    glossaryStub(
      site,
      terms.find((term) => term.id === id)
    )
  ),
  postNode(site, postForLinks, { about, mentions }),
  ...(data.faq.length > 0 ? [faqNode(data.faq)] : []),
  webPageNode(
    site,
    `/blog/${post.id}`,
    lastmod({ publishDate: data.publishDate, updatedDate: data.updatedDate }),
    data.title,
    {
      image: imageObject(metadata.openGraph.images[0]),
      speakableSelectors: ['h1', '[data-answer]', '[data-gate-lead]'],
    }
  ),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <MarkdownAlternate path={`/blog/${post.id}`} slot="head" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Writing`} href="/blog/rss.xml" slot="head" />

  <Breadcrumbs
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog' },
      { name: categoryTitle, path: `/blog/category/${data.category}` },
      { name: data.title, path: `/blog/${post.id}` },
    ]}
  />

  <article>
    <Section
      bordered={false}
      headingLevel={1}
      eyebrow={`${categoryTitle} · ${published} · ${readingTime(post.body ?? '')}`}
      title={data.title}
      lead={data.description}
    />

    <Section eyebrow="Answer" title="The short answer" tone="surface">
      <AnswerBlock question={data.title} answer={data.shortAnswer} />
      <p class="mt-10 max-w-[68ch] text-muted" data-gate-lead>{data.fullAnswer}</p>
      <p class="mt-6 font-mono text-xs text-muted" data-gate-ignore>
        Published{' '}
        <time datetime={data.publishDate.toISOString().slice(0, 10)}>
          {data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {' · Updated '}
        <time datetime={data.updatedDate.toISOString().slice(0, 10)}>
          {data.updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </p>
    </Section>

    <Section eyebrow="Takeaways" title="What to remember">
      <KeyTakeaways points={data.keyTakeaways} />
    </Section>

    <Section eyebrow="Detail" title="The long version">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)] lg:gap-16">
        <div class="prose-brief prose-brief-headings min-w-0 max-w-[68ch]">
          <Content />
        </div>
        <div class="lg:sticky lg:top-24 lg:self-start">
          <TableOfContents headings={headings} />
        </div>
      </div>
      {
        data.tags.length > 0 && (
          <nav aria-label="Tags" class="mt-12 flex flex-wrap gap-3 font-mono text-xs">
            {data.tags.map((slug) => (
              <a
                class="border border-line px-3 py-1 text-muted hover:border-primary hover:text-primary"
                href={`/blog/tag/${slug}`}
              >
                {tagBySlug[slug]?.name ?? slug}
              </a>
            ))}
          </nav>
        )
      }
    </Section>

    {
      data.faq.length > 0 && (
        <Section eyebrow="Questions" title="What people ask" tone="surface">
          <FaqList items={data.faq.map((entry) => ({ question: entry.q, answer: entry.a }))} />
        </Section>
      )
    }

    <Section eyebrow="Provenance" title="Where this comes from">
      <SourceList sources={data.sources} />
      {
        author && (
          <div class="mt-12">
            <AuthorBox name={author.data.name} role={author.data.role} bio={author.data.bio} href="/about" />
          </div>
        )
      }
    </Section>

    {
      relatedResources.length > 0 && (
        <Section eyebrow="Resources" title="Take this further" tone="surface">
          <CardGrid columns={2}>
            {relatedResources.map((resource) => (
              <ResourceCard {...resourceCardProps(resource)} />
            ))}
          </CardGrid>
        </Section>
      )
    }

    {
      (previous || next || related.length > 0) && (
        <Section eyebrow="Continue" title="Keep reading">
          {(previous || next) && (
            <nav aria-label="More in this category" class="mb-10 flex flex-wrap gap-x-10 gap-y-4 font-mono text-xs">
              {previous && (
                <a
                  class="text-link inline-block py-1 underline decoration-2 underline-offset-4 hover:decoration-primary"
                  href={`/blog/${previous.id}`}
                >
                  ← Previous: {previous.data.title}
                </a>
              )}
              {next && (
                <a
                  class="text-link inline-block py-1 underline decoration-2 underline-offset-4 hover:decoration-primary"
                  href={`/blog/${next.id}`}
                >
                  Next: {next.data.title} →
                </a>
              )}
            </nav>
          )}
          {related.length > 0 && (
            <CardGrid columns={2}>
              {related.map((entry) => (
                <PostCard
                  title={entry.data.title}
                  href={`/blog/${entry.id}`}
                  excerpt={entry.data.description}
                  date={entry.data.publishDate.toISOString()}
                  readingTime={readingTime(entry.body ?? '')}
                  category={entry.data.category}
                />
              ))}
            </CardGrid>
          )}
        </Section>
      )
    }
  </article>

  <Section title="Next step">
    <CtaBlock
      title="Start with a 30-minute fit call."
      body="If this reads like your situation, we can go through where you actually stand and whether an Assessment is worth your money."
    />
  </Section>
</Layout>
