---
import { getCollection } from 'astro:content';

import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import PaginationLinks from '~/components/site/PaginationLinks.astro';
import PostCard from '~/components/site/PostCard.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { categoryPillars } from '~/data/categories.mjs';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { firstPage, paginationLinks } from '~/utils/paginate.mjs';
import { readingTime } from '~/utils/reading-time.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const posts = (await getCollection('post', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const visible = firstPage(posts);

const metadata = {
  title: 'Writing',
  description: 'Notes on getting AI systems past security review and into production, written for founders and boards.',
};

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: '/blog',
    name: 'Writing',
    description: metadata.description,
    items: visible.map((post) => ({ url: `/blog/${post.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <MarkdownAlternate path="/blog" slot="head" />
  <link rel="alternate" type="application/rss+xml" title="meshin.co — Writing" href="/blog/rss.xml" slot="head" />

  <Breadcrumbs
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog' },
    ]}
  />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Writing"
    title="Writing on AI governance"
    lead="This is my AI governance writing, one question per piece, with the sources it rests on. If a claim needs a number I cannot show you, it is not here."
  />

  <Section title="Articles">
    {
      visible.length === 0 ? (
        <p class="max-w-[62ch] text-muted">Nothing published yet.</p>
      ) : (
        <CardGrid columns={2}>
          {visible.map((post) => (
            <PostCard
              title={post.data.title}
              href={`/blog/${post.id}`}
              excerpt={post.data.description}
              date={post.data.publishDate.toISOString()}
              readingTime={readingTime(post.body ?? '')}
              category={post.data.category}
              tags={post.data.tags}
            />
          ))}
        </CardGrid>
      )
    }
  </Section>

  <PaginationLinks links={paginationLinks('/blog', posts)} currentPage={1} />

  <Section eyebrow="Browse" title="By category">
    <ul class="flex list-none flex-wrap gap-x-10 gap-y-4">
      {
        Object.entries(categoryPillars).map(([slug, pillar]) => (
          <li>
            <a
              class="text-link underline decoration-2 underline-offset-4 hover:decoration-primary font-heading text-lg font-semibold"
              href={`/blog/category/${slug}`}
            >
              {pillar.title}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 max-w-[62ch] text-muted">
      Or browse every article by <a
        class="text-link underline decoration-2 underline-offset-4 hover:decoration-primary"
        href="/blog/tags">tag</a
      >.
    </p>
  </Section>
</Layout>
