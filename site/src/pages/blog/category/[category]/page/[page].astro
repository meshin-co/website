---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import PaginationLinks from '~/components/site/PaginationLinks.astro';
import PostCard from '~/components/site/PostCard.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { categoryPillars } from '~/data/categories.mjs';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { paginate, paginationLinks } from '~/utils/paginate.mjs';
import { readingTime } from '~/utils/reading-time.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('post', ({ data }) => !data.draft);
  const paths = [];
  for (const [category, pillar] of Object.entries(categoryPillars)) {
    const inCategory = posts
      .filter((post) => post.data.category === category)
      .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
    for (const { pageNumber, entries } of paginate(inCategory)) {
      paths.push({
        params: { category, page: String(pageNumber) },
        props: { category, pillar, pageNumber, entries, all: inCategory },
      });
    }
  }
  return paths;
};

interface Props {
  category: string;
  pillar: { title: string; description: string; body: string[] };
  pageNumber: number;
  entries: CollectionEntry<'post'>[];
  all: CollectionEntry<'post'>[];
}

const { category, pillar, pageNumber, entries, all } = Astro.props;
const site = import.meta.env.SITE.replace(/\/$/, '');
const basePath = `/blog/category/${category}/page/${pageNumber}`;

const metadata = {
  title: `${pillar.title}, page ${pageNumber}`,
  description: pillar.description,
  robots: { index: false, follow: true },
};

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: basePath,
    name: pillar.title,
    description: pillar.description,
    items: entries.map((post) => ({ url: `/blog/${post.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog' },
      { name: pillar.title, path: `/blog/category/${category}` },
      { name: `Page ${pageNumber}`, path: basePath },
    ]}
  />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Category"
    title={`${pillar.title}, page ${pageNumber}`}
    lead={pillar.description}
  />

  <Section title="Articles in this category">
    <CardGrid columns={2}>
      {
        entries.map((post) => (
          <PostCard
            title={post.data.title}
            href={`/blog/${post.id}`}
            excerpt={post.data.description}
            date={post.data.publishDate.toISOString()}
            readingTime={readingTime(post.body ?? '')}
            category={post.data.category}
          />
        ))
      }
    </CardGrid>
  </Section>

  <PaginationLinks links={paginationLinks(`/blog/category/${category}`, all)} currentPage={pageNumber} />
</Layout>
