---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import PaginationLinks from '~/components/site/PaginationLinks.astro';
import PostCard from '~/components/site/PostCard.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { archiveTitleOf, categoryPillars } from '~/data/categories.mjs';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { firstPage, paginationLinks } from '~/utils/paginate.mjs';
import { readingTime } from '~/utils/reading-time.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { isPublished } from '~/utils/feeds.mjs';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('post', isPublished);
  return Object.entries(categoryPillars).map(([category, pillar]) => ({
    params: { category },
    props: { pillar, posts: posts.filter((post) => post.data.category === category) },
  }));
};

interface Props {
  pillar: { title: string; description: string; body: string[] };
  posts: CollectionEntry<'post'>[];
}

const { pillar, posts } = Astro.props;
const { category } = Astro.params;
const site = import.meta.env.SITE.replace(/\/$/, '');
const sorted = posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const visible = firstPage(sorted);
const basePath = `/blog/category/${category}`;
const heading = archiveTitleOf(pillar);

const metadata = {
  title: heading,
  description: pillar.description,
  ...(posts.length === 0 ? { robots: { index: false, follow: true } } : {}),
};

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: basePath,
    name: heading,
    description: pillar.description,
    items: visible.map((post) => ({ url: `/blog/${post.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog' },
      { name: heading, path: basePath },
    ]}
  />

  <Section bordered={false} headingLevel={1} eyebrow="Category" title={heading} lead={pillar.description} />

  <Section eyebrow="Position" title="Where I stand on this" tone="surface">
    <div class="grid max-w-[68ch] gap-6 text-lg leading-relaxed text-muted">
      {pillar.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </Section>

  <Section title="Articles in this category">
    {
      visible.length === 0 ? (
        <p class="max-w-[62ch] text-muted">Nothing published in this category yet.</p>
      ) : (
        <CardGrid columns={2}>
          {visible.map((post) => (
            <PostCard
              title={post.data.title}
              href={`/blog/${post.id}`}
              excerpt={post.data.description}
              date={post.data.publishDate.toISOString()}
              readingTime={readingTime(post.body ?? '')}
              category={post.data.category}
              tags={post.data.tags}
            />
          ))}
        </CardGrid>
      )
    }
  </Section>

  <PaginationLinks links={paginationLinks(basePath, sorted)} currentPage={1} />

  <Section title="Next step">
    <CtaBlock
      title="Start with a 30-minute fit call."
      body="If this category is the one that describes your problem, we can go through where you actually stand."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
    />
  </Section>
</Layout>
