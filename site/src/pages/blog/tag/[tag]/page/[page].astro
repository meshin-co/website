---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import PaginationLinks from '~/components/site/PaginationLinks.astro';
import PostCard from '~/components/site/PostCard.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { TAGS, tagArchive } from '~/data/tags.mjs';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { paginate, paginationLinks } from '~/utils/paginate.mjs';
import { readingTime } from '~/utils/reading-time.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { isPublished } from '~/utils/feeds.mjs';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = (await getCollection('post', isPublished)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );
  return TAGS.flatMap((tag) => {
    const tagged = posts.filter((post) => post.data.tags.includes(tag.slug));
    return paginate(tagged).map(({ pageNumber, entries }) => ({
      params: { tag: tag.slug, page: String(pageNumber) },
      props: { tag, pageNumber, entries, all: tagged },
    }));
  });
};

interface Props {
  tag: { slug: string; name: string };
  pageNumber: number;
  entries: CollectionEntry<'post'>[];
  all: CollectionEntry<'post'>[];
}

const { tag, pageNumber, entries, all } = Astro.props;
const site = import.meta.env.SITE.replace(/\/$/, '');
const archivePath = `/blog/tag/${tag.slug}`;
const basePath = `${archivePath}/page/${pageNumber}`;

const archive = tagArchive(tag);
const metadata = {
  title: `${archive.title}, page ${pageNumber}`,
  description: archive.description,
  robots: { index: false, follow: true },
};

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: basePath,
    name: archive.title,
    description: archive.description,
    items: entries.map((post) => ({ url: `/blog/${post.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog' },
      { name: 'Tags', path: '/blog/tags' },
      { name: archive.title, path: archivePath },
      { name: `Page ${pageNumber}`, path: basePath },
    ]}
  />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Tag"
    title={`${archive.title}, page ${pageNumber}`}
    lead={archive.description}
  />

  <Section title="Articles">
    <CardGrid columns={2}>
      {
        entries.map((post) => (
          <PostCard
            title={post.data.title}
            href={`/blog/${post.id}`}
            excerpt={post.data.description}
            date={post.data.publishDate.toISOString()}
            readingTime={readingTime(post.body ?? '')}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </CardGrid>
  </Section>

  <PaginationLinks links={paginationLinks(archivePath, all)} currentPage={pageNumber} />

  <Section title="Next step">
    <CtaBlock />
  </Section>
</Layout>
