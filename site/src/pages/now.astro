---
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { staticPageDate } from '~/utils/machine-text.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const UPDATED = new Date(staticPageDate('/now'));

const metadata = {
  title: 'What I am working on now',
  description:
    'What I am working on now: a dated log of what I am building and studying, newest first. A line is added when something happens and never edited after.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Now', path: '/now' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/now', UPDATED, metadata.title),
];

type LogEntry = { date: string; text: string; links?: { label: string; href: string }[] };

const log: LogEntry[] = [
  {
    date: 'September 2026',
    text: 'Working through ISO/IEC 42001, the AI management system standard. Studying it, not certified against it: no exam booked and no certificate to claim.',
  },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow={`Updated ${UPDATED.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}`}
    title="What I am working on now"
    lead="What I am working on now, kept as a log with the newest line first. A line is added when something actually happens and is not edited afterwards, so there is nothing here to keep in sync. What is not on the list is not being worked on."
  />

  <Section title="The log">
    <dl class="border-line grid border-t">
      {
        log.map((entry) => (
          <div class="border-line grid gap-2 border-b py-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] sm:gap-8">
            <dt class="eyebrow">{entry.date}</dt>
            <dd class="min-w-0 max-w-[68ch] text-muted">
              {entry.text}
              {entry.links && (
                <span class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                  {entry.links.map((link) => (
                    <a
                      class="text-link inline-block py-1 font-mono text-sm"
                      href={link.href}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Ask what is free right now."
      body="Availability is a question for the call, not a line on a page that would be wrong a week later."
    />
  </Section>
</Layout>
