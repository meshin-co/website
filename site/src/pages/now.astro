---
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const UPDATED = new Date('2026-09-16');

const metadata = {
  title: 'Now',
  description:
    'A dated log of what I am building and studying, newest first. A line is added when something happens and never edited after.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Now', path: '/now' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/now', null, metadata.title),
];

const log = [
  {
    date: 'September 2026',
    text: 'Working through ISO/IEC 42001, the AI management system standard. Studying it, not certified against it: no exam booked and no certificate to claim.',
  },
  {
    date: 'August 2026',
    text: 'Shipped Smarter Day 3.7.0, the iOS app I build and publish myself. Free on the App Store, filed under Productivity.',
    links: [
      { label: 'smarter.day', href: 'https://smarter.day/' },
      { label: 'App Store', href: 'https://apps.apple.com/app/apple-store/id6736619323' },
    ],
  },
  {
    date: 'November 2025',
    text: 'First release of Smarter Day: a structured day, tasks, habits and an Eisenhower priority matrix in one app.',
  },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow={`Updated ${UPDATED.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}`}
    title="What I am working on now"
    lead="What I am working on now, kept as a log with the newest line first. A line is added when something actually happens and is not edited afterwards, so nothing here has to be kept in sync. What is not on the list is not being worked on."
  />

  <Section title="The log">
    <dl class="border-line grid border-t">
      {
        log.map((entry) => (
          <div class="border-line grid gap-2 border-b py-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] sm:gap-8">
            <dt class="eyebrow">{entry.date}</dt>
            <dd class="min-w-0 max-w-[68ch] text-muted">
              {entry.text}
              {entry.links && (
                <span class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                  {entry.links.map((link) => (
                    <a
                      class="text-link inline-block py-1 font-mono text-sm"
                      href={link.href}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Ask what is free right now."
      body="Availability is a question for the call, not a line on a page that would be wrong a week later."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
      note="Or email hello@meshin.co"
    />
  </Section>
</Layout>
