---
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const UPDATED = new Date('2026-09-08');

const metadata = {
  title: 'Now',
  description: 'What I am working on this month, what I am reading, and how much capacity is actually free.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Now', path: '/now' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/now', null, metadata.title),
];

const blocks = [
  {
    label: 'Working on',
    items: ['Filled in when the site launches.'],
  },
  {
    label: 'Capacity',
    items: ['Filled in when the site launches. Until then, ask on the call.'],
  },
  {
    label: 'Reading',
    items: ['Filled in when the site launches.'],
  },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow={`Updated ${UPDATED.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}`}
    title="What I am working on now"
    lead="I update this list of what I am working on now once a month, by hand, not generated. When the capacity line says nothing is free, it means nothing is free. It stays empty until there is something true to put in it."
  />

  <Section title="This month">
    <dl class="grid gap-px bg-line sm:grid-cols-3">
      {
        blocks.map((block) => (
          <div class="bg-page p-6">
            <dt class="eyebrow">{block.label}</dt>
            <dd class="mt-4 grid gap-3">
              {block.items.map((item) => (
                <span class="block max-w-[44ch] text-muted">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Ask what is actually free this month."
      body="Capacity changes weekly, so it is a question for the call rather than a line on a page."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
      note="Or email hello@meshin.co"
    />
  </Section>
</Layout>
