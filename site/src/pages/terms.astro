---
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { breadcrumbNode, orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { staticPageDate } from '~/utils/machine-text.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { SITE } from 'astrowind:config';

const site = import.meta.env.SITE.replace(/\/$/, '');
const UPDATED = staticPageDate('/terms');

const metadata = {
  title: 'Terms',
  description: 'What this site is, why no price appears on it, and which terms actually govern an engagement.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Terms', path: '/terms' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/terms', UPDATED, metadata.title),
  breadcrumbNode(site, crumbs),
];

const sections = [
  {
    title: 'What this site is',
    body: 'A description of a consulting practice. Nothing here is an offer capable of acceptance, and nothing here is legal, financial or compliance advice. If you act on something you read here without checking it against your own situation, that is your decision.',
  },
  {
    title: 'Fees',
    body: 'No price appears anywhere on this site, only fee shapes: a fixed fee, a fixed scope quoted once, or a monthly fee. The number that binds either of us is the one written into the signed statement of work for your engagement, which also fixes scope, duration and payment terms.',
  },
  {
    title: 'Engagements',
    body: 'Each engagement runs under its own written agreement covering confidentiality, intellectual property, liability and termination. That agreement overrides this page wherever the two differ. You own the deliverables and the code produced for you. What stays mine is the method: how I structure an assessment, build eval templates and run a risk review. I reuse that method with other clients, never your material.',
  },
  {
    title: 'Content',
    body: `The writing on this site is mine, and I license it under CC BY 4.0. You may copy, share and adapt it, including for commercial use, if you credit ${SITE.name} as the author, link to the page and to the licence, and say if you changed it. The licence text is at /licenses/CC-BY-4.0.txt and governs where this summary differs from it.`,
  },
  {
    title: 'Availability',
    body: 'Pages may change or disappear. Published articles keep their address where I can manage it, and redirect where I cannot.',
  },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow={`Updated ${UPDATED}`}
    title="Terms."
    lead="These terms are short, because the engagement contract is the document that matters and this page is not it."
  />

  <Section title="Detail">
    <div class="grid gap-12">
      {
        sections.map((section) => (
          <div>
            <h2 class="font-heading text-xl font-semibold text-heading">{section.title}</h2>
            <p class="mt-4 max-w-[68ch] leading-relaxed text-muted">{section.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Next step">
    <CtaBlock />
  </Section>
</Layout>
