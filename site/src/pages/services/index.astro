---
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';

import CardGrid from '~/components/site/CardGrid.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import Section from '~/components/site/Section.astro';
import ServiceCard from '~/components/site/ServiceCard.astro';
import Layout from '~/layouts/PageLayout.astro';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';
import { isPublished } from '~/utils/feeds.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const services = (await getCollection('service', isPublished)).sort((a, b) => a.data.order - b.data.order);

const metadata = {
  title: 'Fractional AI leadership services',
  description:
    'Fractional AI leadership services in three offers: a two-week assessment, a 90-day production sprint or a retainer, run by a Fractional Chief AI Officer.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: '/services',
    name: 'Services',
    description: metadata.description,
    items: services.map((service) => ({ url: `/services/${service.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <MarkdownAlternate path="/services" slot="head" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${SITE.name} — Offers`}
    href="/services/rss.xml"
    slot="head"
  />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Offers"
    title="Fractional AI leadership services"
    lead="I sell fractional AI leadership services three ways: a two-week assessment, a 90-day production sprint and a monthly retainer. Each one has a fixed shape, and the number reaches you in writing before any work starts. Pick the one that matches whether you need a diagnosis, a shipped process or an ongoing owner."
  />

  <Section title="What you can buy">
    <CardGrid>
      {
        services.map((service) => (
          <ServiceCard
            name={service.data.name}
            feeShape={service.data.feeShape}
            duration={service.data.duration}
            outcome={service.data.tagline}
            deliverables={service.data.deliverables}
            href={`/services/${service.id}`}
          />
        ))
      }
    </CardGrid>
  </Section>

  <Section title="Not sure which one">
    <CtaBlock
      title="Start with the two-week Assessment."
      body="It is the cheapest way to find out whether the rest is worth your money. If it is not, I say so in the memo."
    />
  </Section>
</Layout>
