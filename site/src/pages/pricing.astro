---
import { getCollection } from 'astro:content';

import CtaBlock from '~/components/site/CtaBlock.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { breadcrumbNode, orgNode, personNode, serviceNode } from '~/utils/jsonld.mjs';
import { formatPrice } from '~/utils/offers.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const services = (await getCollection('service')).sort((a, b) => a.data.order - b.data.order);

const metadata = {
  title: 'Pricing',
  description:
    'Assessment $5,000 fixed. Production Sprint from $25,000. Fractional CAIO retainer from $12,000 a month.',
};

const nodes = [
  orgNode(site),
  personNode(site),
  ...services.map((service) => serviceNode(site, { id: service.id, ...service.data })),
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: '/pricing' },
  ]),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Section
    bordered={false}
    headingLevel={1}
    index="01"
    eyebrow="Pricing"
    title="What it costs."
    lead="Prices are here so you can plan without a call. The Assessment fee is credited against a Sprint that starts within three months."
  />

  <Section title="The three offers">
    <section class="overflow-x-auto" aria-label="Offer comparison table" tabindex="0">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-line">
            <th class="py-3 pr-4 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">Offer</th>
            <th class="py-3 pr-4 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">Price</th>
            <th class="py-3 pr-4 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">Duration</th>
            <th class="py-3 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">What it produces</th>
          </tr>
        </thead>
        <tbody>
          {
            services.map((service) => (
              <tr class="border-b border-line last:border-b-0">
                <th class="py-5 pr-4 font-normal" scope="row">
                  <a class="text-link" href={`/services/${service.id}`}>
                    {service.data.name}
                  </a>
                </th>
                <td class="py-5 pr-4 font-mono text-heading">{formatPrice(service.data.price)}</td>
                <td class="py-5 pr-4 font-mono text-sm text-muted">{service.data.duration}</td>
                <td class="max-w-[38ch] py-5 text-muted">{service.data.tagline}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </Section>

  <Section index="02" eyebrow="Terms" title="How billing works" tone="surface">
    <ul class="grid gap-3 sm:grid-cols-2 sm:gap-x-14">
      {
        [
          'The Assessment is a fixed fee, invoiced at the start, credited against a Sprint inside three months.',
          'Sprints are quoted per engagement from the scope agreed in the statement of work, never per hour.',
          'The retainer is monthly, cancellable with thirty days of notice, and ends in a handover.',
          'Travel, if you want me on site, is billed at cost and agreed in advance.',
        ].map((term) => (
          <li class="grid grid-cols-[auto_1fr] gap-3">
            <span class="mt-2 inline-block size-1.5 bg-primary" aria-hidden="true" />
            <span class="max-w-[62ch] text-muted">{term}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Start with a 30-minute fit call."
      body="If the Assessment is not worth your money, I will tell you on the call rather than in the invoice."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
      note="Or email hello@meshin.co"
    />
  </Section>
</Layout>
