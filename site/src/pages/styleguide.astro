---
import AnswerBlock from '~/components/site/AnswerBlock.astro';
import AuthorBox from '~/components/site/AuthorBox.astro';
import CaseMetrics from '~/components/site/CaseMetrics.astro';
import FaqList from '~/components/site/FaqList.astro';
import KeyTakeaways from '~/components/site/KeyTakeaways.astro';
import PostCard from '~/components/site/PostCard.astro';
import SourceList from '~/components/site/SourceList.astro';
import TableOfContents from '~/components/site/TableOfContents.astro';
import CardGrid from '~/components/site/CardGrid.astro';
import CtaBlock from '~/components/site/CtaBlock.astro';
import FigureStrip from '~/components/site/FigureStrip.astro';
import ShiftPanel from '~/components/site/ShiftPanel.astro';
import Hero from '~/components/site/Hero.astro';
import ResourceCard from '~/components/site/ResourceCard.astro';
import Section from '~/components/site/Section.astro';
import ServiceCard from '~/components/site/ServiceCard.astro';
import SignalList from '~/components/site/SignalList.astro';
import StepList from '~/components/site/StepList.astro';
import { artifacts, heroOffers, drivers, figures, hero, services, shift, signals } from '~/data/home';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Styleguide',
  description: 'Every component in every state, both themes. Internal reference page.',
  robots: { index: false, follow: false },
};

const swatches = ['page', 'text', 'muted', 'primary', 'line'];
---

<Layout metadata={metadata}>
  <Section
    bordered={false}
    headingLevel={1}
    title="Styleguide"
    lead="Internal reference. Not indexed, not in the sitemap."
  >
    <p class="font-mono text-sm text-muted">Toggle the theme in the header to check both palettes.</p>
  </Section>

  <Section title="Colour">
    <ul class="grid gap-4 sm:grid-cols-5">
      {
        swatches.map((swatch) => (
          <li class="grid gap-2">
            <span class:list={['swatch', `swatch-${swatch}`]} />
            <span class="font-mono text-xs text-muted">{swatch}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="Type scale">
    <div class="grid gap-4">
      <p class="font-heading text-[clamp(2.2rem,5vw,3.5rem)] leading-tight font-semibold text-heading">
        Display · Fraunces 600
      </p>
      <h2 class="font-heading text-3xl font-semibold text-heading">Heading 2 · Fraunces 600</h2>
      <h3 class="font-heading text-xl font-semibold text-heading">Heading 3 · Fraunces 600</h3>
      <p class="max-w-[70ch]">
        Body · IBM Plex Sans 400 at 18px / 1.6 with a 70ch measure. Governance that passes procurement and agents that
        reach production, described in sentences a buyer can read once.
      </p>
      <p class="font-mono text-sm text-muted">Mono · system stack · 42 findings · 90 days · 2026-09-07</p>
    </div>
  </Section>

  <Section title="Buttons and links">
    <div class="flex flex-wrap items-center gap-6">
      <button class="btn-primary" type="button">Primary</button>
      <button class="btn" type="button">Secondary</button>
      <button class="btn-primary" type="button" disabled>Disabled</button>
      <a class="text-link underline underline-offset-4" href="/styleguide">Text link</a>
    </div>
  </Section>

  <Section title="Hero">
    <Hero
      offers={heroOffers}
      title={hero.title}
      titleAccent={hero.titleAccent}
      sub={hero.sub}
      proof={hero.proof}
      ctaLabel={hero.ctaLabel}
      ctaHref={hero.ctaHref}
      secondary={{ label: 'secondary link →', href: '/styleguide' }}
    />
  </Section>

  <Section title="Figure strip">
    <FigureStrip figures={figures} />
  </Section>

  <Section title="Shift panel">
    <ShiftPanel before={shift.before} after={shift.after} />
  </Section>

  <Section title="Signal list">
    <SignalList items={signals.items.slice(0, 3)} verdict={signals.verdict} />
  </Section>

  <Section title="Service cards">
    <CardGrid>
      {services.map((service) => <ServiceCard {...service} href="/styleguide" />)}
    </CardGrid>
  </Section>

  <Section title="Step list">
    <StepList steps={drivers.slice(0, 3)} />
  </Section>

  <Section title="Resource cards">
    <CardGrid columns={2}>
      {artifacts.slice(0, 2).map((artifact) => <ResourceCard {...artifact} />)}
    </CardGrid>
  </Section>

  <Section title="Call to action">
    <CtaBlock
      title="One primary action per screen."
      body="Secondary actions stay visually subordinate."
      label="Book a call"
      href="https://cal.com/meshin"
      note="A mono note carries the fallback contact route."
    />
  </Section>

  <Section title="Prose and tables">
    <div class="grid gap-6">
      <ul class="grid list-disc gap-2 pl-6">
        <li>Unordered item with a <a class="text-link underline" href="/styleguide">link inside prose</a>.</li>
        <li>Second item.</li>
      </ul>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <caption class="pb-3 text-left font-mono text-sm text-muted">Offer comparison</caption>
          <thead>
            <tr class="border-b border-line">
              <th class="py-2 pr-4 font-semibold" scope="col">Offer</th>
              <th class="py-2 pr-4 font-semibold" scope="col">Price</th>
              <th class="py-2 font-semibold" scope="col">Duration</th>
            </tr>
          </thead>
          <tbody>
            {
              services.map((service) => (
                <tr class="border-b border-line last:border-b-0">
                  <td class="py-2 pr-4">{service.name}</td>
                  <td class="py-2 pr-4 font-mono text-sm">{service.feeShape}</td>
                  <td class="py-2 font-mono text-sm">{service.duration}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <FaqList
        items={[
          {
            question: 'Native details element, used for every FAQ',
            answer: 'No JavaScript, keyboard-operable, open by default when linked.',
          },
          { question: 'A second entry, to show the divider', answer: 'Answers wrap at the same measure as body copy.' },
        ]}
      />
    </div>
  </Section>

  <Section title="Answer block">
    <AnswerBlock
      question="What does a Fractional Chief AI Officer actually do?"
      answer="Owns AI risk by name, gets one process into production, and hands it to an internal owner."
    />
  </Section>

  <Section title="Takeaways band">
    <KeyTakeaways
      points={[
        'One process in production beats five pilots.',
        'Procurement asks who owns AI risk, not which model you use.',
        'Evals in CI are what stop a prompt change shipping unnoticed.',
      ]}
    />
  </Section>

  <Section title="Post cards">
    <CardGrid columns={2}>
      <PostCard
        title="Why your AI pilot never reached production"
        href="/styleguide"
        excerpt="The gap is rarely the model. It is data ownership, evals and a named owner."
        date="2026-09-01"
        readingTime="7 min read"
        category="governance"
      />
      <PostCard
        title="What procurement asks about AI, and how to answer once"
        href="/styleguide"
        excerpt="A register, a policy and a classification table answer most of the questionnaire."
        date="2026-08-18"
        readingTime="5 min read"
      />
    </CardGrid>
  </Section>

  <Section title="Table of contents">
    <TableOfContents
      headings={[
        { depth: 2, slug: 'where-pilots-stall', text: 'Where pilots stall' },
        { depth: 3, slug: 'data-ownership', text: 'Data ownership' },
        { depth: 2, slug: 'what-to-measure', text: 'What to measure' },
      ]}
    />
  </Section>

  <Section title="Case metrics">
    <CaseMetrics
      metrics={[
        { label: 'Questionnaire turnaround', before: '3 weeks', after: '1 day' },
        { label: 'Processes in production', before: '0', after: '1' },
      ]}
      note="Sample figures. Real case pages ship only with numbers a client has approved."
    />
  </Section>

  <Section title="Author box">
    <AuthorBox
      name="Dmitri Meshin"
      role="Fractional Chief AI Officer"
      bio="Platform engineer who gets AI systems past security review and into production."
      href="/styleguide"
    />
  </Section>

  <Section title="Source list">
    <SourceList
      sources={[
        {
          title: 'ISO/IEC 42001:2023 Artificial intelligence management system',
          publisher: 'ISO',
          url: 'https://www.iso.org/standard/81230.html',
          retrieved: '2026-09-08',
        },
        {
          title: 'AI Risk Management Framework',
          publisher: 'NIST',
          url: 'https://www.nist.gov/itl/ai-risk-management-framework',
        },
      ]}
    />
  </Section>
</Layout>

<style>
  .swatch {
    display: block;
    height: 4rem;
    border: 1px solid var(--aw-color-line);
  }

  .swatch-page {
    background: var(--aw-color-bg-page);
  }

  .swatch-text {
    background: var(--aw-color-text-default);
  }

  .swatch-muted {
    background: var(--aw-color-text-muted);
  }

  .swatch-primary {
    background: var(--aw-color-primary);
  }

  .swatch-line {
    background: var(--aw-color-line);
  }
</style>
