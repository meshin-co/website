---
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { SITE } from 'astrowind:config';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const UPDATED = '2026-09-08';

const metadata = {
  title: 'Privacy',
  description: 'What this site collects, which is almost nothing, and what happens to an email you send me.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Privacy', path: '/privacy' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/privacy', UPDATED, metadata.title),
];

const sections = [
  {
    title: 'What this site collects',
    body: 'No cookies are set and no accounts exist. Page views are counted by Plausible, which is cookieless and stores no personal data: a page path, a referrer, a country, and a device type. Nothing there identifies you, and there is no cross-site profile to opt out of.',
  },
  {
    title: 'What the host sees',
    body: 'Cloudflare serves these files and keeps request logs, including IP addresses, for its own abuse prevention and for a limited period. That is a technical necessity of serving a page over the internet, not a choice about analytics.',
  },
  {
    title: 'Email and calls',
    body: `If you email hello@${SITE.name} or book a call, I keep that thread and the booking so I can answer and account for the work. Enquiries that never become paid work are deleted twelve months after the last message. Anything I have invoiced is kept for six years, for accounting. There is no mailing list to be added to.`,
  },
  {
    title: 'Client material',
    body: 'The work happens in your own systems, under your contract, on an account you issue and revoke. I keep no copy of your documents, exports, tickets or logs, and my own working notes are deleted at handover.',
  },
  {
    title: 'Your rights',
    body: `You can ask what I hold about you, ask for it to be corrected, or ask for it to be deleted, and I will answer within thirty days. Email hello@${SITE.name}. If you are unhappy with the answer you can complain to your local data protection authority.`,
  },
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow={`Updated ${UPDATED}`}
    title="Privacy policy"
    lead="This privacy policy covers a static site with no accounts and no cookies. It exists so you do not have to take that on trust."
  />

  <Section title="Detail">
    <div class="grid gap-12">
      {
        sections.map((section) => (
          <div>
            <h2 class="font-heading text-xl font-semibold text-heading">{section.title}</h2>
            <p class="mt-4 max-w-[68ch] leading-relaxed text-muted">{section.body}</p>
          </div>
        ))
      }
    </div>
  </Section>
</Layout>
