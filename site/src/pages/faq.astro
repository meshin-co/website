---
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';

import CtaBlock from '~/components/site/CtaBlock.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import MarkdownAlternate from '~/components/common/MarkdownAlternate.astro';
import Section from '~/components/site/Section.astro';
import Layout from '~/layouts/PageLayout.astro';
import { teaser } from '~/utils/faq-meta.mjs';
import { collectionNode, orgNode, personNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');
const entries = (await getCollection('faq', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

const GROUPS = [
  { key: 'general', title: 'Working together' },
  { key: 'governance', title: 'Governance and risk' },
  { key: 'operating-model', title: 'How engagements run' },
  { key: 'agentic-architecture', title: 'Building the systems' },
  { key: 'executive', title: 'For boards' },
];

const grouped = GROUPS.map((group) => ({
  ...group,
  items: entries.filter((entry) => entry.data.category === group.key),
})).filter((group) => group.items.length > 0);

const metadata = {
  title: 'Fractional Chief AI Officer questions',
  description:
    'Fractional Chief AI Officer questions answered: what the role does, what each offer produces, and how AI risk gets recorded and signed off.',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq' },
];

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  collectionNode(site, {
    path: '/faq',
    name: metadata.title,
    description: metadata.description,
    items: entries.map((entry) => ({ url: `/faq/${entry.id}` })),
  }),
];
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />
  <MarkdownAlternate path="/faq" slot="head" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${SITE.name} — Questions and answers`}
    href="/faq/rss.xml"
    slot="head"
  />

  <Breadcrumbs crumbs={crumbs} />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="FAQ"
    title="Fractional Chief AI Officer questions, answered"
    lead="These are the Fractional Chief AI Officer questions people ask me most, before they book a call. If your question is not here, email it. I answer in writing, and the good ones end up on this page."
  />

  {
    grouped.map((group) => (
      <Section eyebrow="Questions" title={group.title}>
        <ol class="grid gap-px bg-line">
          {group.items.map((entry) => (
            <li class="bg-page p-6">
              <h3 class="font-heading text-lg font-semibold text-heading">
                <a class="text-link inline-block py-1" href={`/faq/${entry.id}`}>
                  {entry.data.question}
                </a>
              </h3>
              <p class="mt-3 max-w-[68ch] text-muted">{teaser(entry.data.answer)}</p>
            </li>
          ))}
        </ol>
      </Section>
    ))
  }

  <Section title="Still unsure">
    <CtaBlock
      title="Ask it on a 30-minute call."
      body="No slides. If your situation does not need me, I will say so."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
    />
  </Section>
</Layout>
