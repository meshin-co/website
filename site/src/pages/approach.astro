---
import CtaBlock from '~/components/site/CtaBlock.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Section from '~/components/site/Section.astro';
import ShiftPanel from '~/components/site/ShiftPanel.astro';
import StepList from '~/components/site/StepList.astro';
import Layout from '~/layouts/PageLayout.astro';
import { breadcrumbNode, orgNode, personNode, webPageNode, websiteNode } from '~/utils/jsonld.mjs';
import { src as ogDefaultPath } from '~/utils/og-default.mjs';

const site = import.meta.env.SITE.replace(/\/$/, '');

const metadata = {
  title: 'How I work',
  description:
    'The six things that decide whether an AI initiative reaches production, and the order I work through them.',
};

const nodes = [
  orgNode(site, { logoPath: ogDefaultPath }),
  personNode(site),
  websiteNode(site),
  webPageNode(site, '/approach', null, metadata.title),
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Approach', path: '/approach' },
  ]),
];

const measures = [
  {
    name: 'Data readiness',
    detail: "I find out what data you actually hold, and that decides what a vendor's model may ever touch.",
  },
  {
    name: 'Process fit',
    detail: 'I pick the one process with enough volume and a clear outcome to prove automation actually paid off.',
  },
  {
    name: 'Governance',
    detail: 'I check whether your governance paperwork is real, or just something that looks like a control.',
  },
  {
    name: 'Engineering capability',
    detail: 'I test whether your engineers can already roll back a bad model without waiting on me.',
  },
  {
    name: 'Adoption',
    detail: 'I check who is still using the system a month after launch, from logs, not from the announcement email.',
  },
  {
    name: 'Handover',
    detail:
      'I close every engagement by naming an internal owner and writing down the decisions. Needing me two years later means I failed at this one.',
  },
];

const sequence = [
  {
    name: 'Read what exists',
    detail:
      'Repositories, data flows, vendor contracts and the spreadsheets people actually use. Descriptions come later.',
  },
  {
    name: 'Name the owner',
    detail: 'One person accountable for AI risk, on the org chart, with the authority to say no.',
  },
  {
    name: 'Classify the data',
    detail: 'I decide what may reach a vendor and who has the final call when that is unclear.',
  },
  {
    name: 'Pick one process',
    detail: 'Volume plus a measurable outcome. If success needs a survey to detect, it is the wrong process.',
  },
  {
    name: 'Ship it with evals',
    detail: 'Evals in CI, tracing, cost per outcome and a rollback path before it touches a customer.',
  },
  {
    name: 'Hand it over',
    detail: 'The runbook and the decisions go to a named internal owner, and the engagement ends there.',
  },
];

const shiftContent = {
  before: {
    label: 'Today',
    items: [
      'A pilot looks finished in the demo and stops there.',
      'Nobody with the authority to say no owns the AI risk.',
      'A security questionnaire stalls the deal for weeks.',
      'Budget keeps moving and the process underneath it stays the same.',
    ],
  },
  after: {
    label: 'After the engagement',
    items: [
      'One process is live in production, evals running in CI.',
      'One named person owns AI risk and reports on it to the board.',
      'Security questionnaires get answered from the register, same day.',
      'What each outcome costs sits on a dashboard, next to the contract value.',
    ],
  },
};
---

<Layout metadata={metadata}>
  <JsonLd nodes={nodes} slot="head" />

  <Section
    bordered={false}
    headingLevel={1}
    eyebrow="Method"
    title="How a Fractional AI Officer works with your team"
    lead="This is how a Fractional AI Officer works: six signals, always in the same order, before I touch any code. The sixth, handover, is structurally the hardest one, because nothing forces it once a system is already live."
  />

  <Section eyebrow="Measures" title="What I measure" tone="surface">
    <StepList steps={measures} ordered />
  </Section>

  <Section eyebrow="Sequence" title="The order I work in">
    <StepList steps={sequence} ordered />
  </Section>

  <Section eyebrow="Outcome" title="What changes" tone="surface">
    <ShiftPanel before={shiftContent.before} after={shiftContent.after} />
  </Section>

  <Section title="Next step">
    <CtaBlock
      title="Start with a 30-minute fit call."
      body="I go through where you actually stand against these six, and what the first ninety days would cover."
      label="Book a 30-min fit call"
      href="https://cal.com/meshin"
      note="Or email hello@meshin.co"
    />
  </Section>
</Layout>
