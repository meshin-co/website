---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Page not found',
  description: 'This page does not exist on meshin.co. Start from the home page.',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-24">
    <p class="font-mono text-sm text-muted">Error 404</p>
    <h1 class="mt-4 font-heading text-4xl font-semibold text-heading">This page does not exist.</h1>
    <p class="mt-4 max-w-[70ch] text-muted">The link may be old or mistyped. Start from the home page.</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn-primary" href={getHomePermalink()}>Home</a>
    </div>
  </section>
</Layout>
