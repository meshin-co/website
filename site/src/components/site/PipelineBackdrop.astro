---
const stages = ['Pilot', 'Evals', 'Gateway', 'Production'];
---

<div class="pointer-events-none absolute inset-x-0 bottom-8 mx-auto max-w-6xl px-5 sm:px-8" aria-hidden="true">
  <div class="flex items-center">
    {
      stages.map((stage, index) => (
        <>
          {index > 0 && <span class="pipe-edge h-px flex-1"></span>}
          <span class="grid justify-items-center gap-2">
            <span class:list={['pipe-node', index === stages.length - 1 && 'pipe-node-live']}></span>
            <span class="pipe-stage">{stage}</span>
          </span>
        </>
      ))
    }
  </div>
</div>

<style>
  .pipe-edge {
    background-image: linear-gradient(
      to right,
      color-mix(in oklch, var(--aw-color-text-heading) 20%, transparent) 0 3px,
      transparent 3px 8px
    );
    background-size: 8px 1px;
    margin-bottom: 1.35rem;
  }

  .pipe-node {
    background-color: color-mix(in oklch, var(--aw-color-text-heading) 20%, transparent);
    height: 0.5rem;
    width: 0.5rem;
  }

  .pipe-node-live {
    background-color: var(--aw-color-primary);
  }

  .pipe-stage {
    color: color-mix(in oklch, var(--aw-color-text-heading) 32%, transparent);
    font-family: var(--aw-font-mono, monospace);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
