---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<div class="border-l-2 border-primary pl-6" data-answer>
  <h2 class="font-heading text-2xl font-semibold text-heading">{question}</h2>
  <p class="mt-4 max-w-[68ch] text-lg leading-relaxed text-muted">{answer}</p>
</div>
