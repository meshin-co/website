---
interface Props {
  metrics: { label: string; before: string; after: string }[];
  note?: string;
}

const { metrics, note } = Astro.props;
---

<div class="border-t border-line">
  <table class="w-full border-collapse text-left">
    <thead>
      <tr class="border-b border-line">
        <th class="py-3 pr-4 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">Measure</th>
        <th class="py-3 pr-4 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">Before</th>
        <th class="py-3 font-mono text-xs tracking-[0.16em] text-muted uppercase" scope="col">After</th>
      </tr>
    </thead>
    <tbody>
      {
        metrics.map((metric) => (
          <tr class="border-b border-line last:border-b-0">
            <th class="py-4 pr-4 font-normal text-muted" scope="row">
              {metric.label}
            </th>
            <td class="py-4 pr-4 font-mono text-heading">{metric.before}</td>
            <td class="py-4 font-mono text-primary">{metric.after}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {note && <p class="mt-5 font-mono text-xs text-muted">{note}</p>}
</div>
