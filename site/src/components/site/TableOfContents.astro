---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  label?: string;
}

const { headings, label = 'On this page' } = Astro.props;
const entries = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  entries.length > 0 && (
    <nav aria-label={label} class="border-t border-line pt-5" data-toc>
      <p class="eyebrow">{label}</p>
      <ol class="mt-4 grid border-l border-line">
        {entries.map((heading) => (
          <li>
            <a
              class:list={[
                '-ml-px block border-l-2 border-transparent py-1 text-sm text-link aria-[current=location]:border-primary aria-[current=location]:text-heading',
                heading.depth === 3 ? 'pl-8' : 'pl-4',
              ]}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  const toc = document.querySelector('[data-toc]');

  if (toc && 'IntersectionObserver' in window) {
    const entries = [...toc.querySelectorAll('a')].flatMap((link) => {
      const heading = document.getElementById(link.getAttribute('href')!.slice(1));
      return heading ? [{ link, heading }] : [];
    });

    const mark = () => {
      const line = window.innerHeight / 4;
      const current = entries.filter(({ heading }) => heading.getBoundingClientRect().top <= line).pop();

      for (const { link } of entries) {
        if (link === current?.link) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    const observer = new IntersectionObserver(mark, { rootMargin: '0px 0px -75% 0px' });
    for (const element of entries[0]?.heading.parentElement!.children ?? []) observer.observe(element);
  }
</script>
