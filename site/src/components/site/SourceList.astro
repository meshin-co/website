---
interface Props {
  sources: { title: string; url: string; publisher?: string; retrieved?: string }[];
  label?: string;
}

const { sources, label = 'Sources' } = Astro.props;

const publisherOf = (source: Props['sources'][number]) =>
  source.publisher ?? new URL(source.url).hostname.replace(/^www\./, '');
---

<section class="border-t border-line pt-6" aria-label={label}>
  <h2 class="eyebrow">{label}</h2>
  <ol class="mt-4 grid gap-4">
    {
      sources.map((source) => (
        <li class="grid gap-1">
          <a class="text-link" href={source.url} rel="noopener nofollow" target="_blank">
            {source.title}
          </a>
          <p class="font-mono text-xs text-muted" data-gate-ignore>
            {publisherOf(source)}
            {source.retrieved && <span>{` · retrieved ${source.retrieved}`}</span>}
          </p>
        </li>
      ))
    }
  </ol>
</section>
