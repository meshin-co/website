---
import { citedHost, standInNote } from '~/utils/archive-url.mjs';
import { externalRelAttrs } from '~/utils/pipeline.mjs';

interface Props {
  sources: { title: string; url: string; original?: string; publisher?: string; retrieved?: string }[];
  label?: string;
}

const { sources, label = 'Sources' } = Astro.props;

const listed = sources.map((source) => ({
  ...source,
  publisher: source.publisher ?? citedHost(source),
  note: standInNote(source),
}));
---

<section class="border-t border-line pt-6" aria-label={label}>
  <h2 class="eyebrow">{label}</h2>
  <ol class="mt-4 grid gap-4">
    {
      listed.map((source) => (
        <li class="grid gap-1">
          <a class="text-link inline-block py-1" href={source.url} {...externalRelAttrs(source.url)} target="_blank">
            {source.title}
          </a>
          <p class="font-mono text-xs text-muted" data-gate-ignore>
            {source.publisher}
            {source.retrieved && <span>{` · retrieved ${source.retrieved}`}</span>}
            {source.note && ` · ${source.note}`}
          </p>
        </li>
      ))
    }
  </ol>
</section>
