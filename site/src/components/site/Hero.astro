---
interface Props {
  title: string;
  titleAccent: string;
  sub: string;
  proof: string[];
  ctaLabel: string;
  ctaHref: string;
  offers: { label: string; figure: string; name: string; note: string }[];
  secondary?: { label: string; href: string };
}

const { title, titleAccent, sub, proof, ctaLabel, ctaHref, offers, secondary } = Astro.props;
const external = ctaHref.startsWith('http');
---

<section class="relative overflow-hidden border-b border-line">
  <div class="hairline-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-20">
    <p class="eyebrow">Fractional Chief AI Officer</p>

    <h1
      class="mt-10 font-heading text-[clamp(2.5rem,6.2vw,4.5rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-heading"
    >
      {title}&#32;<span class="accent-underline">{titleAccent}</span>
    </h1>

    <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-muted">{sub}</p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        class="btn-primary"
        href={ctaHref}
        {...external ? { target: '_blank', rel: 'nofollow noopener noreferrer' } : {}}>{ctaLabel}</a
      >
      {
        secondary && (
          <a class="link-signature text-base" href={secondary.href}>
            {secondary.label}
          </a>
        )
      }
    </div>

    <dl class="mt-14 grid border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-line">
      {
        offers.map((offer, position) => (
          <div
            class:list={[
              'py-6',
              position > 0 && 'border-t border-line sm:border-t-0',
              position === 1 && 'sm:px-10',
              position === 2 && 'sm:pl-10',
            ]}
          >
            <dt class="font-mono text-xs tracking-[0.08em] text-muted uppercase">{offer.label}</dt>
            <dd class="mt-3 font-mono text-2xl text-heading figure-num">{offer.figure}</dd>
            <dd class="mt-3">
              <a class="inline-block py-1 text-sm font-semibold text-heading" href="/services">
                {offer.name}
              </a>
            </dd>
            <dd class="mt-2 max-w-[34ch] text-sm leading-snug text-muted">{offer.note}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-6">
      {
        proof.map((item) => (
          <li class="flex items-baseline gap-3">
            <span class="inline-block size-1.5 shrink-0 bg-primary" aria-hidden="true" />
            <span class="text-sm text-muted">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
