---
interface Props {
  title: string;
  titleAccent: string;
  sub: string;
  proof: string[];
  ctaLabel: string;
  ctaHref: string;
  brief: { label: string; value: string }[];
  secondary?: { label: string; href: string };
}

const { title, titleAccent, sub, proof, ctaLabel, ctaHref, brief, secondary } = Astro.props;
const external = ctaHref.startsWith('http');
---

<section class="relative overflow-hidden border-b border-line">
  <div class="hairline-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-20 sm:px-8 sm:pt-20 sm:pb-28">
    <p class="eyebrow">Fractional Chief AI Officer</p>

    <div class="mt-12 grid gap-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-16">
      <div>
        <h1
          class="font-heading text-[clamp(2.5rem,6.2vw,4.5rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-heading"
        >
          {title}&#32;<span class="accent-underline">{titleAccent}</span>
        </h1>

        <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-muted">{sub}</p>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a class="btn-primary" href={ctaHref} {...external ? { target: '_blank', rel: 'noopener' } : {}}>{ctaLabel}</a
          >
          {
            secondary && (
              <a class="link-signature text-base" href={secondary.href}>
                {secondary.label}
              </a>
            )
          }
        </div>
      </div>

      <aside class="card self-start p-6 sm:p-7 lg:mt-1">
        <p class="eyebrow">Engagement brief</p>
        <dl class="mt-6 grid gap-0 divide-y divide-line">
          {
            brief.map((item) => (
              <div class="grid grid-cols-[7rem_1fr] items-baseline gap-4 py-3.5 first:pt-0 last:pb-0">
                <dt class="font-mono text-xs tracking-[0.08em] text-muted uppercase">{item.label}</dt>
                <dd class="font-mono text-sm text-heading figure-num">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <ul class="mt-16 grid gap-3 sm:grid-cols-2 sm:gap-x-14">
      {
        proof.map((item) => (
          <li class="flex items-baseline gap-3">
            <span class="inline-block size-1.5 shrink-0 bg-primary" aria-hidden="true" />
            <span class="text-sm text-muted">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
