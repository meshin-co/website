---
interface Props {
  title: string;
  href: string;
  excerpt: string;
  date: string;
  readingTime: string;
  category?: string;
}

const { title, href, excerpt, date, readingTime, category } = Astro.props;
const published = new Date(date);
const meta = category ? `${readingTime} · ${category}` : readingTime;
---

<article class="flex h-full flex-col border border-line p-6">
  <p class="eyebrow">
    <time datetime={published.toISOString().slice(0, 10)}>
      {published.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
    </time>
    {` · ${meta}`}
  </p>

  <h3 class="mt-5 font-heading text-xl font-semibold text-heading">
    <a class="text-link" href={href}>{title}</a>
  </h3>

  <p class="mt-4 grow text-muted">{excerpt}</p>
</article>
