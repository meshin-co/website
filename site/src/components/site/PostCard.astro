---
import { categoryPillars } from '~/data/categories.mjs';

interface Props {
  title: string;
  href: string;
  excerpt: string;
  date: string;
  readingTime?: string;
  category?: string;
  tags?: string[];
}

const { title, href, excerpt, date, readingTime, category, tags = [] } = Astro.props;
const published = new Date(date);
const pillar = category ? (categoryPillars[category as keyof typeof categoryPillars] ?? null) : null;
const categoryTitle = category ? (pillar?.title ?? category) : undefined;
---

<article
  class="group relative flex h-full flex-col border border-line p-6 focus-within:border-primary"
  data-gate-ignore
>
  <p class="eyebrow">
    <time datetime={published.toISOString().slice(0, 10)}>
      {published.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
    </time>
    {readingTime && ` · ${readingTime}`}
    {
      categoryTitle && (
        <>
          {' · '}
          {pillar && (
            <a
              class="relative z-[1] text-link underline decoration-2 underline-offset-4 hover:decoration-primary"
              href={`/blog/category/${category}`}
            >
              {categoryTitle}
            </a>
          )}
          {!pillar && categoryTitle}
        </>
      )
    }
  </p>

  <h3 class="mt-5 font-heading text-xl font-semibold text-heading">
    <a class="text-link after:absolute after:inset-0 after:content-['']" href={href}>{title}</a>
  </h3>

  <p class="mt-4 grow text-muted">{excerpt}</p>

  {
    tags.length > 0 && (
      <p class="mt-4 font-mono text-xs text-muted">
        {tags.map((tag, index) => (
          <>
            {index > 0 && ' · '}
            <a
              class="relative z-[1] text-link underline decoration-2 underline-offset-4 hover:decoration-primary"
              href={`/blog/tag/${tag}`}
            >
              {tag}
            </a>
          </>
        ))}
      </p>
    )
  }
</article>
