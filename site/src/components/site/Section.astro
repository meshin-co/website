---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  tone?: 'page' | 'surface';
  bordered?: boolean;
  headingLevel?: 1 | 2;
}

const { id, eyebrow, title, lead, tone = 'page', bordered = true, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---

<section id={id} class:list={[tone === 'surface' && 'bg-surface', bordered && 'border-t border-line']}>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    {
      eyebrow && (
        <div class:list={['mb-12 flex items-center gap-5', tone === 'surface' ? 'bg-surface' : 'bg-page']}>
          <span class="eyebrow leading-none">{eyebrow}</span>
          <span class="h-px grow bg-line" aria-hidden="true" />
        </div>
      )
    }

    {
      (title || lead) && (
        <div class="grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-16">
          {title && (
            <Heading class="font-heading text-3xl leading-[1.15] font-semibold tracking-[-0.02em] text-heading sm:text-[2.6rem]">
              {title}
            </Heading>
          )}
          {lead && <p class="max-w-[62ch] text-muted">{lead}</p>}
        </div>
      )
    }

    <div class:list={[(title || lead) && 'mt-12']}>
      <slot />
    </div>
  </div>
</section>
