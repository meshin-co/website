---
interface Props {
  title: string;
  body: string;
  label: string;
  href: string;
  note?: string;
}

const { title, body, label, href, note } = Astro.props;
const external = href.startsWith('http');
---

<div class="bg-accent-tint border border-line" data-gate-ignore>
  <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,4fr)] lg:items-center lg:gap-16">
    <div>
      <h2
        class="font-heading text-[clamp(1.85rem,3.4vw,2.75rem)] leading-[1.1] font-semibold tracking-[-0.02em] text-heading"
      >
        {title}
      </h2>
      <p class="mt-5 max-w-[52ch] text-muted">{body}</p>
    </div>

    <div class="flex flex-col items-start gap-5 lg:items-center lg:justify-self-end lg:text-center">
      <a class="btn-primary" href={href} {...external ? { target: '_blank', rel: 'nofollow noopener noreferrer' } : {}}
        >{label}</a
      >
      {note && <p class="font-mono text-xs text-muted">{note}</p>}
    </div>
  </div>
</div>
