---
import { SITE } from 'astrowind:config';
import { BOOKING_LABEL, BOOKING_URL } from '~/utils/booking.mjs';
import { externalRelAttrs } from '~/utils/pipeline.mjs';

interface Props {
  title?: string;
  body?: string;
  label?: string;
  href?: string;
  note?: string;
  secondary?: { label: string; href: string };
}

const {
  title = 'Start with a 30-minute fit call.',
  body = 'Bring the process you want in production and who owns it today. You leave knowing whether an Assessment, a Sprint or neither is the next step.',
  label = BOOKING_LABEL,
  href = BOOKING_URL,
  note = `Or email hello@${SITE.name}`,
  secondary,
} = Astro.props;
const outbound = externalRelAttrs(href);
---

<div class="bg-accent-tint border border-line" data-gate-ignore>
  <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,4fr)] lg:items-center lg:gap-16">
    <div>
      <h2
        class="font-heading text-[clamp(1.85rem,3.4vw,2.75rem)] leading-[1.1] font-semibold tracking-[-0.02em] text-heading"
      >
        {title}
      </h2>
      <p class="mt-5 max-w-[52ch] text-muted">{body}</p>
    </div>

    <div class="flex flex-col items-start gap-5 lg:items-center lg:justify-self-end lg:text-center">
      <a class="btn-primary" href={href} {...outbound} {...outbound.rel ? { target: '_blank' } : {}}>{label}</a>
      {
        secondary && (
          <a class="link-signature text-sm" href={secondary.href} {...externalRelAttrs(secondary.href)}>
            {secondary.label}
          </a>
        )
      }
      {note && <p class="font-mono text-xs text-muted">{note}</p>}
    </div>
  </div>
</div>
