---
interface Props {
  items: { question: string; answer: string; id?: string; sources?: { title: string; url: string }[] }[];
}

const { items } = Astro.props;
---

<div class="grid gap-px bg-line">
  {
    items.map((item) => (
      <div class="bg-page">
        <details class="group px-6 py-5" id={item.id}>
          <summary class="flex cursor-pointer items-baseline gap-4 marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="w-3 font-mono text-sm text-muted group-open:hidden" aria-hidden="true">
              +
            </span>
            <span class="hidden w-3 font-mono text-sm text-primary group-open:inline" aria-hidden="true">
              −
            </span>
            <h3 class="font-heading text-lg font-semibold text-heading">{item.question}</h3>
          </summary>
          <p class="mt-4 max-w-[68ch] pl-7 text-muted">{item.answer}</p>
          {item.sources && item.sources.length > 0 && (
            <p class="mt-3 max-w-[68ch] pl-7 font-mono text-xs text-muted">
              <span class="eyebrow">Sources</span>{' '}
              {item.sources.map((source, index) => (
                <>
                  {index > 0 && ' · '}
                  <a class="text-link inline-block py-1" href={source.url} target="_blank" rel="noopener">
                    {source.title}
                  </a>
                </>
              ))}
            </p>
          )}
        </details>
      </div>
    ))
  }
</div>
