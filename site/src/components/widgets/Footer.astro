---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="not-prose border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-start md:gap-16">
      <div>
        <a class="inline-block" href={getHomePermalink()}><Logo /></a>

        {
          secondaryLinks.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
              {secondaryLinks.map(({ text, href }) => (
                <li>
                  <a class="link-signature hover:link-signature-hover" href={href} set:html={text} />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        links.length > 0 && (
          <div class="grid gap-10 sm:grid-cols-2 md:gap-16">
            {links.map(({ title, links: column }) => (
              <div>
                <p class="eyebrow">{title}</p>
                <ul class="mt-4 grid gap-2 text-sm">
                  {column.map(({ text, href }) => (
                    <li>
                      <a class="link-signature hover:link-signature-hover" href={href} set:html={text} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-9 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-line pt-6">
      <p class="font-mono text-xs text-muted">{footNote}</p>

      {
        socialLinks.length > 0 && (
          <ul class="-ml-2 flex items-center gap-2 md:ml-0 md:-mr-2">
            {socialLinks.map(({ ariaLabel, href, icon }) => (
              <li>
                <a
                  class="flex size-9 items-center justify-center text-muted transition duration-150 hover:text-heading"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="size-5" />}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
