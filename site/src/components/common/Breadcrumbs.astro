---
import { Icon } from 'astro-icon/components';

import { breadcrumbNode, graph } from '~/utils/jsonld.mjs';

export interface Props {
  crumbs: Array<{ name: string; path: string }>;
}

const { crumbs } = Astro.props;
const site = import.meta.env.SITE.replace(/\/$/, '');
---

<nav aria-label="Breadcrumb" class="mx-auto w-full max-w-6xl px-5 pt-6 sm:px-8">
  <ol class="eyebrow flex list-none flex-wrap items-center gap-2 leading-none">
    {
      crumbs.map(({ name, path }, index) => (
        <li class="flex min-w-0 items-center gap-2">
          {index > 0 && <Icon name="tabler:chevron-right" class="h-3.5 w-3.5 shrink-0 opacity-60 rtl:rotate-180" />}
          {index < crumbs.length - 1 ? (
            <a href={path} class="hover:text-primary hover:underline">
              {name}
            </a>
          ) : (
            <span aria-current="page">{name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph([breadcrumbNode(site, crumbs)]))} />
